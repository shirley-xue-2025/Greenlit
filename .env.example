# Copy to .env. Do not commit .env.
# OpenAI-compatible Qwen endpoint (chat + embeddings).

LLM_PROVIDER=custom
LLM_MODEL=openai/qwen-flash
LLM_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_KEY=

DATA_ROOT_DIRECTORY=.cognee_data
SYSTEM_ROOT_DIRECTORY=.cognee_system

ENABLE_BACKEND_ACCESS_CONTROL=false
CACHING=false

# Slack (optional). Socket Mode. Leave blank to run the dashboard without a bot.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
